{
  "$ref": "#/definitions/projects",
  "definitions": {
    "projects": {
      "type": "object",
      "properties": {
        "order": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "title": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "stack": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "href": {
          "type": "string",
          "format": "uri"
        },
        "cta": {
          "type": "string",
          "default": "VIEW PROJECT"
        },
        "cover": {
          "type": "string"
        },
        "coverAlt": {
          "type": "string"
        },
        "screentone": {
          "type": "boolean",
          "default": false
        },
        "variant": {
          "type": "string",
          "enum": [
            "featured",
            "compact",
            "dark"
          ],
          "default": "compact"
        },
        "$schema": {
          "type": "string"
        }
      },
      "required": [
        "order",
        "title",
        "category",
        "summary",
        "stack"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}