<nav
	id="navbar"
	class="p-8 sticky top-0 z-10 transition-colors duration-300 flex justify-between items-center"
>
	<div>
		<a href="/">
			<h1 class="nav-title">Alvaro Falcón.</h1>
		</a>
	</div>

	<!-- Menú desktop (oculto en móvil) -->
	<div class="hidden md:flex gap-4">
		<a href="/"> <h1 class="nav-link">ABOUT</h1></a>
		<a href="/"> <h1 class="nav-link">PROJECTS</h1></a>
		<a href="/"> <h1 class="nav-link">CONTACT</h1></a>
	</div>

	<!-- Checkbox oculto para controlar el menú móvil -->
	<input type="checkbox" id="menu-toggle" class="hidden" />

	<!-- Botón hamburguesa (solo visible en móvil) -->
	<label
		for="menu-toggle"
		class="md:hidden cursor-pointer flex flex-col gap-1.5 z-20"
	>
		<span class="hamburger-line"></span>
		<span class="hamburger-line"></span>
		<span class="hamburger-line"></span>
	</label>

	<!-- Menú móvil desplegable -->
	<div class="mobile-menu">
		<div class="mobile-menu-content">
			<a href="/" class="mobile-link">ABOUT</a>
			<a href="/" class="mobile-link">PROJECTS</a>
			<a href="/" class="mobile-link">CONTACT</a>
		</div>
	</div>
</nav>

<style>
	.hamburger-line {
		width: 25px;
		height: 3px;
		background-color: currentColor;
		transition: all 0.3s ease;
		transform-origin: center;
	}

	#menu-toggle:checked ~ label .hamburger-line:nth-child(1) {
		transform: rotate(45deg) translate(8px, 8px);
	}

	#menu-toggle:checked ~ label .hamburger-line:nth-child(2) {
		opacity: 0;
	}

	#menu-toggle:checked ~ label .hamburger-line:nth-child(3) {
		transform: rotate(-45deg) translate(7px, -7px);
	}

	.mobile-menu {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100vh;
		background-color: rgba(255, 255, 255, 0.98);
		backdrop-filter: blur(10px);
		transform: translateX(-100%);
		transition: transform 0.3s ease-in-out;
		z-index: 10;
		padding-top: 100px;
	}

	#menu-toggle:checked ~ .mobile-menu {
		transform: translateX(0);
	}

	.mobile-menu-content {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 2rem;
		padding: 2rem;
	}

	.mobile-link {
		font-size: 1.5rem;
		font-weight: 600;
		color: #000;
		text-decoration: none;
		transition: opacity 0.2s;
	}

	.mobile-link:hover {
		opacity: 0.7;
	}

	@media (min-width: 768px) {
		.mobile-menu {
			display: none;
		}
	}
</style>

<script>
	const navbar = document.getElementById("navbar");
	const navbarVisible = [
		"bg-white",
		"backdrop-blur-xl",
		"bg-opacity-90",
		"drop-shadow-md",
	];
	function handleScroll() {
		if (window.scrollY > 0) {
			navbar?.classList.add(...navbarVisible);
		} else {
			navbar?.classList.remove(...navbarVisible);
		}
	}

	window.addEventListener("scroll", handleScroll);
	handleScroll();
</script>
