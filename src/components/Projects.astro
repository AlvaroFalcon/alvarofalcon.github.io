---
import ProjectItem from "./ProjectItem.astro";
const projects = [
	{
		title: "Bakalendar",
		description:
			"Native Android mobile application that displays a seasonal anime release calendar and allows users to set daily alerts for their favorite shows. Built entirely in Kotlin using an MVVM architecture, with API consumption via Retrofit, dependency injection with Hilt, and local data persistence using Room to ensure a smooth and offline-friendly experience.\n\nTechnologies: Kotlin · Android · MVVM · Retrofit · Hilt · Room",
		href: "https://play.google.com/store/apps/details?id=com.frostfel.animelist&hl=en",
		type: "Android",
	},
	{
		title: "Hina",
		description:
			"Work-in-progress web application designed to help users learn and memorize Japanese hiragana and katakana through a progressive, module-based approach. The app focuses on gradual learning by unlocking new modules as the user advances, reinforcing memorization and reading skills. Built with Next.js and Supabase for user management, authentication, and data storage.\n\nTechnologies: Next.js · Supabase · TypeScript",
		href: "#projects",
		type: "Web",
	},
	{
		title: "Automated Grocery List",
		description:
			"Personal project created to automate the grocery planning process by generating a single shopping list from selected recipes. Recipes and their ingredients are stored in Notion, while a Telegram bot retrieves and aggregates the required ingredients based on the meals chosen, simplifying and streamlining the shopping workflow.\n\nTechnologies: Notion API · Telegram Bot API · Typescript",
		href: "https://dev.to/alvarofalcon/automating-grocery-lists-with-notion-and-telegram-1h35",
		type: "Bot",
	},
	{
		title: "Nefroconsultor",
		description:
			"Android and iOS mobile application that supports clinical decision-making for Chronic Kidney Disease, aimed at primary care physicians and other medical specialists. I have collaborated intermittently on the project over an extended period, contributing to the development and maintenance of the mobile applications. \n\nTechnologies: Android · Java · iOS · Objective-C",
		href: "https://play.google.com/store/apps/details?id=com.madilon.nefroconsultor&hl=es&pli=1",
		type: "Mobile",
	},
];
---

<div class="bg-gray-50 w-full relative flex flex-col" id="projects">
	<div class="section-container flex flex-col gap-8">
		<h3 class="text-5xl md:text-7xl shadowed-title">Projects</h3>

		<div class="flex flex-col gap-4 flex-1">
			{
				projects.map((project) => (
					<ProjectItem
						title={project.title}
						description={project.description}
						href={project.href}
						type={project.type}
					/>
				))
			}
		</div>
	</div>
</div>
