---
import Image from "astro/components/Image.astro";
import Button from "./Button.astro";
---

<div
	class="relative md:absolute top-0 left-0 right-0 speed-lines w-full min-h-screen flex flex-col"
>
	<div
		class="halftone min-h-screen relative md:absolute top-0 left-0 right-0 flex header-inner w-full flex-1"
	>
		<div
			class="manga-border border-2 border-black p-4 w-3/4 h-3/4 flex flex-col-reverse md:flex-row bg-white halftone relative gap-2 m-auto"
		>
			<div class="flex flex-col flex-1 gap-4">
				<div class="flex flex-col flex-1 gap-4">
					<h2 class="text-base text-gray-500">// DEV</h2>
					<h1 class="font-bold text-black title">ALVARO FALCÓN</h1>
					<h1 class="font-bold text-white subtitle">Frontend Developer</h1>
					<div class="h-1 bg-red-600 w-20"></div>
					<h3 class="italic text-gray-500">
						"In software development, every obstacle has a solution. With the
						right mindset, anything is achievable."
					</h3>
				</div>
				<div class="flex gap-2">
					<Button variant="primary">View Projects</Button>
					<Button variant="outline">Contact</Button>
				</div>
			</div>

			<div class="flex flex-col flex-1 overflow-hidden">
				<Image
					src="/main.png"
					alt="Profile"
					class="profile-pic"
					width={500}
					height={500}
					loading="eager"
				/>
			</div>
		</div>
	</div>
</div>
