---
import Image from "astro/components/Image.astro";
---

<div
	class="min-h-screen absolute top-0 left-0 right-0 overflow-hidden speed-lines"
>
	<div
		class="halftone min-h-screen absolute top-0 left-0 right-0 flex items-center justify-center"
	>
		<div
			class="border-2 border-black p-4 w-3/4 h-3/4 flex flex-col-reverse md:flex-row bg-white halftone relative gap-2"
		>
			<div class="flex flex-col flex-1 gap-4">
				<h2 class="text-base text-gray-500">// DEV</h2>
				<h1 class="font-bold text-black title">ALVARO FALCÓN</h1>
				<h1 class="font-bold text-white subtitle">Frontend Developer</h1>
				<div class="h-1 bg-red-600 w-20"></div>
			</div>
			<div class="flex flex-col flex-1">
				<Image
					src="/main.png"
					alt="Profile"
					class="profile-pic"
					width={500}
					height={500}
					loading="eager"
				/>
			</div>
		</div>
	</div>
</div>
