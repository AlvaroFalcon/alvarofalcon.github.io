---
import { SITE_CONFIG } from "~/lib/site-config";

// Resolved at build time, so the notice never goes stale.
const year = new Date().getFullYear();
---

<footer>
	<div class="inner">
		<span>© {year} {SITE_CONFIG.name.toUpperCase()}</span>
		<span class="end">THE END — SOFTWARE ENGINEER</span>
	</div>
</footer>

<style>
	footer {
		margin-top: 56px;
		background: var(--ink);
		color: var(--paper);
		border-top: var(--border-rule) solid var(--ink);
	}

	.inner {
		max-width: var(--container-max);
		margin: 0 auto;
		padding: 26px var(--container-pad);
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 14px;
		font-size: var(--text-meta);
		font-weight: 700;
		letter-spacing: var(--tracking-label);
	}

	.end {
		opacity: 0.7;
	}
</style>
