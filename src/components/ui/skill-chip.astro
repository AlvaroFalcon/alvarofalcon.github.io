---
import type { HTMLAttributes } from "astro/types";

/** An outlined tag in the About panel's skill row. */
type Props = HTMLAttributes<"span">;

const { class: className, ...rest } = Astro.props;
---

<span class:list={["skill-chip", className]} {...rest}>
	<slot />
</span>

<style>
	.skill-chip {
		border: var(--border-chip) solid var(--ink);
		padding: 8px 14px;
		font-size: var(--text-label);
		font-weight: 700;
		letter-spacing: var(--tracking-chip-label);
	}
</style>
