---
import { Image } from "astro:assets";
import InkPanel from "~/components/ui/ink-panel.astro";
import InkButton from "~/components/ui/ink-button.astro";
import ChapterChip from "~/components/ui/chapter-chip.astro";

/*
 * One project panel. Fully prop-driven — the projects section maps collection
 * entries onto this, so the card never reaches for content itself.
 */
interface Props {
	/** Collection id; names the card for the view transition to its page. */
	slug: string;
	/** Chapter number, rendered as "CH. 01". */
	order: number;
	title: string;
	category: string;
	summary: string;
	stack: string[];
	/** The project's detail page. */
	href: string;
	/** Unreleased work gets a WIP tag beside the category. */
	wip?: boolean;
	/** Private code gets a PRIVATE tag beside the category. */
	isPrivate?: boolean;
	cover?: ImageMetadata | undefined;
	coverAlt?: string | undefined;
	screentone?: boolean;
	variant?: "featured" | "compact" | "dark";
}

const {
	slug,
	order,
	title,
	category,
	summary,
	stack,
	href,
	wip = false,
	isPrivate = false,
	cover,
	coverAlt,
	screentone = false,
	variant = "compact",
} = Astro.props;

const isDark = variant === "dark";
const chapter = `CH. ${String(order).padStart(2, "0")}`;
---

<a
	href={href}
	class="card-link"
	data-variant={variant}
	aria-labelledby={`project-${slug}-title`}
>
	<InkPanel
		as="article"
		style={`view-transition-name: project-${slug};`}
		tone={isDark ? "ink" : "panel"}
		lift
		class="project-card"
		data-variant={variant}
	>
		{
			variant === "featured" && (
				<div class="media">
					<span class="texture texture--speed-lines" />
					{cover && (
						<Image
							src={cover}
							alt={coverAlt ?? ""}
							widths={[400, 800, 1200]}
							sizes="(max-width: 780px) 100vw, 50vw"
							loading="lazy"
							decoding="async"
						/>
					)}
				</div>
			)
		}

		{
			screentone && (
				<span
					class="texture texture--dots texture--fade-top-left"
					style="--dot-size: 9px;"
				/>
			)
		}

		{/* Keeps the copy as one grid item beside the featured image. */}
		<div class="content">
			<div class="head">
				<div class="meta">
					<ChapterChip tone={isDark ? "paper" : "ink"}>{chapter}</ChapterChip>
					<span class="category">{category}</span>
					{wip && <span class="tag">WIP</span>}
					{isPrivate && <span class="tag">PRIVATE</span>}
				</div>
				<h3 id={`project-${slug}-title`}>{title}</h3>
			</div>

			<div class="body">
				<p class="summary">{summary}</p>
				<p class="stack">{stack.join(" · ")}</p>
				{/* A span, not a link: the whole card is already the link. */}
				<InkButton variant={isDark ? "on-dark" : "outline"} class="cta">
					VIEW PROJECT →
				</InkButton>
			</div>
		</div>
	</InkPanel>
</a>

<style>
	/*
	 * The whole card is one link, so it is one big click target and a single
	 * tab stop. The wrapper takes the card's place in the projects grid.
	 */
	.card-link {
		display: flex;
		color: inherit;
	}

	.card-link:hover {
		color: inherit;
	}

	.card-link[data-variant="featured"],
	.card-link[data-variant="dark"] {
		grid-column: 1 / -1;
	}

	.card-link > :global(.project-card) {
		flex: 1;
	}

	.card-link:focus-visible {
		outline-offset: 6px;
	}

	.card-link:hover .cta,
	.card-link:focus-visible .cta {
		--button-bg: var(--button-hover-bg);
		--button-fg: var(--button-hover-fg);
	}
	.project-card {
		position: relative;
		overflow: hidden;
		display: flex;
		flex-direction: column;
		gap: 14px;
		padding: 30px 32px;
	}

	/* ---- Shared type ------------------------------------------------------ */
	h3 {
		margin: 0;
		font-family: var(--font-display);
		font-size: var(--text-project-title-compact);
		font-weight: 400;
		line-height: var(--leading-display);
		text-transform: uppercase;
		/* Titles carry deliberate line breaks from the data. */
		white-space: pre-line;
	}

	.content,
	.head,
	.body {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 14px;
	}

	/* Both stretch so the CTA can sit on the bottom edge of the card. */
	.content,
	.body {
		flex: 1;
	}

	.meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 12px;
	}

	.tag {
		border: var(--border-chip) solid currentColor;
		padding: 2px 8px;
		font-size: var(--text-chip);
		font-weight: 900;
		letter-spacing: var(--tracking-chip-label);
	}

	.project-card {
		--button-hover-bg: var(--ink);
		--button-hover-fg: var(--paper);
	}

	.project-card[data-variant="dark"] {
		--button-hover-bg: var(--paper);
		--button-hover-fg: var(--ink);
	}

	.category {
		font-size: var(--text-meta);
		font-weight: 700;
		letter-spacing: var(--tracking-label);
		color: var(--accent);
	}

	.summary {
		margin: 0;
		font-size: var(--text-body);
		line-height: var(--leading-body);
		text-wrap: pretty;
	}

	.stack {
		margin: 0;
		font-size: var(--text-meta);
		font-weight: 700;
		letter-spacing: var(--tracking-meta);
		opacity: 0.65;
	}

	.cta {
		margin-top: auto;
		align-self: flex-start;
	}

	/* ---- Featured: full width, image beside the copy ---------------------- */
	.project-card[data-variant="featured"] {
		display: grid;
		grid-template-columns: repeat(
			auto-fit,
			minmax(min(100%, var(--col-featured)), 1fr)
		);
		gap: 0;
		padding: 0;
	}

	.media {
		position: relative;
		background: var(--paper-2);
		overflow: hidden;
		/* Reserves height before the image decodes, so nothing shifts. */
		min-height: 300px;
	}

	.media :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.project-card[data-variant="featured"] .content {
		padding: 32px 34px;
	}

	.project-card[data-variant="featured"] h3 {
		font-size: var(--text-project-title-featured);
	}

	/* ---- Dark: full width, title opposite the copy ------------------------ */
	.project-card[data-variant="dark"] {
		display: grid;
		grid-template-columns: repeat(
			auto-fit,
			minmax(min(100%, var(--col-projects)), 1fr)
		);
		gap: 28px;
		align-items: center;
		padding: 34px 36px;
	}

	/*
	 * The dark card puts the title opposite the copy, so head and body have to
	 * be grid items of the card itself rather than of a shared wrapper.
	 */
	.project-card[data-variant="dark"] .content {
		display: contents;
	}

	.project-card[data-variant="dark"] h3 {
		font-size: var(--text-project-title-dark);
	}

	/* On ink the kicker is already high-contrast; accent would vibrate. */
	.project-card[data-variant="dark"] .category {
		color: inherit;
	}
</style>
